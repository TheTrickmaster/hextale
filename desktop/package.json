{
  "name": "hextale",
  "productName": "Hextale",
  "version": "1.0.2",
  "description": "Hextale",
  "main": "main.js",
  "author": "BigFennel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "gioco": "node prepara-gioco.js",
    "prova": "node prova-aggiornatore.js && node prova-pubblica-r2.js && node prepara-gioco.js --copia-di-lavoro && electron prova-guscio.js",
    "build": "node crea-certificato.js && node prepara-gioco.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.thetrickmaster.hextale",
    "productName": "Hextale",
    "copyright": "BigFennel",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "aggiornatore.js", "servitore.js", "certificato/**", "package.json"],
    "extraResources": [{ "from": "gioco-pronto", "to": "gioco" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../ui/exe-icon.png",
      "artifactName": "Hextale-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hextale",
      "runAfterFinish": false,
      "include": "installatore.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
